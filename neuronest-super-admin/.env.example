PORT=3100
NODE_ENV=development

# Google OAuth client used by the admin login screen.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated approved Super Admin emails.
SUPER_ADMIN_EMAILS=frozy@neuronest.ai,superfrozy@neuronest.ai

# Where normal users should be sent when admin access is denied.
NEURONEST_APP_URL=https://neuronest.onrender.com

# Shared NeuroNest data source. Local default is ../pc-ai-dashboard/data/db.json.
NEURONEST_DB_PATH=../pc-ai-dashboard/data/db.json

# Shared uploaded files from the main NeuroNest app.
NEURONEST_UPLOADS_PATH=../pc-ai-dashboard/data/uploads

# Optional service flags for health checks.
OPENAI_API_KEY=
AI_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_MAPS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=neuronest-media

# Polls the shared Supabase production source so separately deployed admin and
# dashboard services show the same records.
ADMIN_PRODUCTION_SYNC_MS=15000

# Local-only helper. Keep false on Render/production.
ALLOW_ADMIN_DEV_LOGIN=false
