PORT=3002
SESSION_SECRET=change-this-to-a-long-random-secret

# Production: point mobile to the deployed PC NeuroNest backend so mobile,
# desktop, and Super Admin all share the same real data source.
NEURONEST_API_BASE_URL=https://your-main-neuronest-app.onrender.com

# Google login web client ID.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional comma-separated extra Google web client IDs accepted by mobile fallback auth.
GOOGLE_CLIENT_IDS=

# Keep this server-side only. The current Google ID-token login flow does not require it,
# but Render can store it safely if you later switch to OAuth code flow.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Maps browser API key. Restrict it to localhost and your Render domain.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
