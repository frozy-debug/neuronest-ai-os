NODE_ENV=development
PORT=3002
SESSION_SECRET=change-this-to-a-long-random-secret

# Production: point mobile to the deployed PC NeuroNest backend so mobile,
# desktop, and Super Admin all share the same real data source.
NEURONEST_API_BASE_URL=https://your-main-neuronest-app.onrender.com
NEURONEST_APP_URL=https://your-main-neuronest-app.onrender.com
NEURONEST_MOBILE_URL=https://your-mobile-neuronest-app.onrender.com
NEURONEST_ADMIN_URL=https://your-admin-neuronest-app.onrender.com

# Google login web client ID.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional comma-separated extra Google web client IDs accepted by mobile fallback auth.
GOOGLE_CLIENT_IDS=

# Keep this server-side only. The current Google ID-token login flow does not require it,
# but Render can store it safely if you later switch to OAuth code flow.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Maps browser API key. Restrict it to localhost and your Render domain.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# These private keys are normally configured on the PC backend Render service.
# Add them to mobile only if you intentionally run mobile as a standalone backend.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ALLOW_LOCAL_AI_FALLBACK=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=neuronest-media
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=25000000
