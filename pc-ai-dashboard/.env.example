PORT=3000
SESSION_SECRET=change-this-to-any-long-random-text

# Google login
# Create this in Google Cloud Console as an OAuth 2.0 Web Client ID.
# Add http://localhost:3000 to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Google Maps
# Create this as a Google Maps Platform browser API key.
# Enable Maps JavaScript API and Places API, then restrict it to http://localhost:3000/*
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# AI Second Brain intelligence
# Keep this only on the backend/Render environment. Never put it in public/index.html.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Never enable this in production. It permits deterministic development-only vectors.
ALLOW_LOCAL_AI_FALLBACK=false

# Optional production vector database using Supabase pgvector.
# Run supabase_memory_vectors.sql in Supabase before enabling these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_MEDIA_BUCKET=neuronest-media

# Optional rate limit override
RATE_LIMIT_PER_MINUTE=120

# Public URL for stored file links in the unified warehouse.
NEURONEST_APP_URL=http://localhost:3000

# On Render, point these to a mounted persistent disk if the JSON warehouse is used.
# Separate Render services cannot share one disk; use the Supabase production schema
# when the PC dashboard and Super Admin are deployed independently.
NEURONEST_DB_PATH=./data/db.json
NEURONEST_UPLOADS_PATH=./data/uploads

# Supports screenshot/audio payloads. Keep within your host's request limits.
MAX_REQUEST_BODY_BYTES=25000000
